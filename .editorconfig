# Reglas de estilo comunes para EMPAMEDIC.
# Visual Studio las aplica al escribir; el CI verifica el formato con "dotnet format".
root = true

[*]
charset = utf-8
# Saltos de línea: los normaliza .gitattributes (LF en el repo, CRLF en Windows)
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,config,xaml,cshtml,html,css,js}]
indent_size = 2

[*.{xaml,cshtml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---- Organización ----
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = block_scoped:silent

# ---- Llaves y líneas nuevas (estilo Allman, el de Visual Studio) ----
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion

# ---- var y tipos ----
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion

# ---- Expresiones ----
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

# ---- Nombres ----
# Interfaces empiezan con I
dotnet_naming_rule.interfaces_con_i.symbols = interfaces
dotnet_naming_rule.interfaces_con_i.style = prefijo_i
dotnet_naming_rule.interfaces_con_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefijo_i.required_prefix = I
dotnet_naming_style.prefijo_i.capitalization = pascal_case

# Tipos, métodos y propiedades en PascalCase
dotnet_naming_rule.tipos_y_miembros_pascal.symbols = tipos_y_miembros
dotnet_naming_rule.tipos_y_miembros_pascal.style = pascal
dotnet_naming_rule.tipos_y_miembros_pascal.severity = warning
dotnet_naming_symbols.tipos_y_miembros.applicable_kinds = class, struct, enum, property, method, event, delegate
dotnet_naming_style.pascal.capitalization = pascal_case

# Campos privados con guion bajo: _nombreCampo
dotnet_naming_rule.campos_privados_guion.symbols = campos_privados
dotnet_naming_rule.campos_privados_guion.style = guion_bajo
dotnet_naming_rule.campos_privados_guion.severity = suggestion
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.guion_bajo.required_prefix = _
dotnet_naming_style.guion_bajo.capitalization = camel_case

# ---- Analizadores ----
# Métodos async sin await o tareas sin esperar: avisar
dotnet_diagnostic.CS4014.severity = warning
# Código no usado
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
