<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appEmpamedic.PageModels"
             xmlns:models="clr-namespace:appEmpamedic.Models"
             x:Class="appEmpamedic.Pages.DashboardPage"
             x:DataType="pageModels:DashboardPageModel"
             Title="Dashboard">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar sesión"
                     IconImageSource="{StaticResource IconCerrarSesion}"
                     Command="{Binding CerrarSesionCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="{StaticResource LayoutPadding}">
                <Label Text="{Binding Saludo}" Style="{StaticResource Title2}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalPacientes}" Style="{StaticResource Title1}" />
                            <Label Text="Pacientes" Style="{StaticResource Caption1}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1">
                        <VerticalStackLayout>
                            <Label Text="{Binding ConsultasHoy}" Style="{StaticResource Title1}" />
                            <Label Text="Consultas hoy" Style="{StaticResource Caption1}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2">
                        <VerticalStackLayout>
                            <Label Text="{Binding MedicamentosStockBajo}" Style="{StaticResource Title1}" />
                            <Label Text="Stock bajo" Style="{StaticResource Caption1}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Controles pendientes" Style="{StaticResource Title3}" Margin="0,10,0,0" />
                <Label Text="No tienes controles pendientes."
                       Style="{StaticResource Body2}"
                       IsVisible="{Binding SinAlertas}" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding AlertasPendientes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SeguimientoAlerta">
                            <Border>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding VerPacienteCommand, Source={RelativeSource AncestorType={x:Type pageModels:DashboardPageModel}}, x:DataType=pageModels:DashboardPageModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding NombreColaborador}" Style="{StaticResource Body1Strong}" />
                                    <Label Text="{Binding Motivo}" Style="{StaticResource Body2}" />
                                    <Label Text="{Binding FechaControl, StringFormat='Control: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption1}" />
                                    <Label Text="Vencido" TextColor="#C62828" Style="{StaticResource Caption1Strong}" IsVisible="{Binding Vencida}" />
                                    <HorizontalStackLayout Spacing="10" Margin="0,6,0,0">
                                        <Button Text="Atendida"
                                                Command="{Binding MarcarAtendidaCommand, Source={RelativeSource AncestorType={x:Type pageModels:DashboardPageModel}}, x:DataType=pageModels:DashboardPageModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Descartar"
                                                BackgroundColor="{StaticResource Gray500}"
                                                Command="{Binding DescartarCommand, Source={RelativeSource AncestorType={x:Type pageModels:DashboardPageModel}}, x:DataType=pageModels:DashboardPageModel}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
