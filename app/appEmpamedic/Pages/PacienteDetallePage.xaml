<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appEmpamedic.PageModels"
             xmlns:models="clr-namespace:appEmpamedic.Models"
             x:Class="appEmpamedic.Pages.PacienteDetallePage"
             x:DataType="pageModels:PacienteDetallePageModel"
             Title="Paciente">

    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="{StaticResource LayoutPadding}">
            <Label Text="{Binding Paciente.NombreCompleto}" Style="{StaticResource Title2}" />

            <Border>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                    <Label Text="Cédula" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Column="1" Text="{Binding Paciente.Cedula}" Style="{StaticResource Body2}" />

                    <Label Grid.Row="1" Text="Cargo" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Paciente.Cargo}" Style="{StaticResource Body2}" />

                    <Label Grid.Row="2" Text="Área" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Paciente.Area}" Style="{StaticResource Body2}" />

                    <Label Grid.Row="3" Text="Nacimiento" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Paciente.FechaNacimiento, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Body2}" />

                    <Label Grid.Row="4" Text="Tipo de sangre" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Paciente.TipoSangre}" Style="{StaticResource Body2}" />

                    <Label Grid.Row="5" Text="Alergias" Style="{StaticResource Body2Strong}" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Paciente.Alergias, TargetNullValue='Ninguna registrada'}" Style="{StaticResource Body2}" />
                </Grid>
            </Border>

            <Label Text="Antecedentes" Style="{StaticResource Title3}" Margin="0,10,0,0" />
            <Label Text="{Binding Paciente.Antecedentes, TargetNullValue='Sin antecedentes registrados'}" Style="{StaticResource Body2}" />

            <Label Text="Historial de consultas" Style="{StaticResource Title3}" Margin="0,10,0,0" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Consultas}">
                <BindableLayout.EmptyView>
                    <Label Text="Sin consultas registradas." Style="{StaticResource Body2}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ConsultaMedica">
                        <Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption1Strong}" />
                                <Label Text="{Binding MotivoConsulta}" Style="{StaticResource Body1Strong}" />
                                <Label Text="{Binding Diagnostico, StringFormat='Diagnóstico: {0}'}" Style="{StaticResource Body2}" />
                                <Label Text="{Binding Tratamiento, StringFormat='Tratamiento: {0}'}" Style="{StaticResource Body2}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
