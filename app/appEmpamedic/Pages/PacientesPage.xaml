<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appEmpamedic.PageModels"
             xmlns:models="clr-namespace:appEmpamedic.Models"
             x:Class="appEmpamedic.Pages.PacientesPage"
             x:DataType="pageModels:PacientesPageModel"
             Title="Pacientes">

    <Grid RowDefinitions="Auto,*" Padding="{StaticResource LayoutPadding}" RowSpacing="10">
        <SearchBar Placeholder="Buscar por nombre o cédula" Text="{Binding Busqueda}" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding CargarCommand}">
            <CollectionView ItemsSource="{Binding Pacientes}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="No hay pacientes." Style="{StaticResource Body2}" HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Colaborador">
                        <Border>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding VerPacienteCommand, Source={RelativeSource AncestorType={x:Type pageModels:PacientesPageModel}}, x:DataType=pageModels:PacientesPageModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding NombreCompleto}" Style="{StaticResource Body1Strong}" />
                                <Label Text="{Binding Cedula, StringFormat='C.I. {0}'}" Style="{StaticResource Caption1}" />
                                <Label Style="{StaticResource Caption1}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Cargo}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Area}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
