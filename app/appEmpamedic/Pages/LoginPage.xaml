<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appEmpamedic.PageModels"
             x:Class="appEmpamedic.Pages.LoginPage"
             x:DataType="pageModels:LoginPageModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="Iniciar sesión">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center" MaximumWidthRequest="420">
            <Label Text="EMPAMEDIC" Style="{StaticResource LargeTitle}" HorizontalOptions="Center" />
            <Label Text="Dispensario médico EMPACRECI" Style="{StaticResource Body2}" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Entry Placeholder="Usuario"
                   Text="{Binding Usuario}"
                   Keyboard="Plain"
                   ReturnType="Next" />

            <Entry Placeholder="Contraseña"
                   Text="{Binding Clave}"
                   IsPassword="True"
                   ReturnType="Done"
                   ReturnCommand="{Binding IniciarSesionCommand}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="#C62828"
                   IsVisible="{Binding MensajeError, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

            <Button Text="Ingresar"
                    Command="{Binding IniciarSesionCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
