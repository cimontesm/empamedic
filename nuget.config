<?xml version="1.0" encoding="utf-8"?>
<!-- Garantiza que todos restauren paquetes desde nuget.org,
     aunque su instalación de Visual Studio no tenga la fuente configurada. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
