<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Empamedic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/frontWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Empamedic</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3 text-secondary small">
                                <span>Hola, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar Sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Empamedic - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <!-- Formulario oculto para el token antiforgery usado en AJAX -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Modal Advertencia Inactividad (RNF06 / HU6) -->
        <div class="modal fade" id="modalInactividad" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="modalInactividadLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title fw-bold" id="modalInactividadLabel">
                            Aviso de Inactividad
                        </h5>
                    </div>
                    <div class="modal-body text-center py-4">
                        <p class="fs-5 mb-2">Tu sesión está a punto de expirar por inactividad.</p>
                        <p class="text-muted mb-3">Por seguridad clínica (RNF06), la sesión se cerrará automáticamente en:</p>
                        <div class="display-6 fw-bold text-danger mb-2" id="contadorSegundos">60s</div>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary">Cerrar sesión ahora</button>
                        </form>
                        <button type="button" class="btn btn-primary px-4" id="btnExtenderSesion">Mantener sesión</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
                (function () {
                    // 9 minutos = 540,000 ms (Aviso) | 10 minutos = 600,000 ms (Cierre)
                    const TIEMPO_AVISO_MS = 9 * 60 * 1000;
                    const TIEMPO_CIERRE_MS = 10 * 60 * 1000;

                    let timeoutAviso;
                    let timeoutCierre;
                    let intervaloConteo;
                    const modalElement = document.getElementById('modalInactividad');
                    let bsModal = null;

                    function reiniciarTemporizadores() {
                        clearTimeout(timeoutAviso);
                        clearTimeout(timeoutCierre);
                        clearInterval(intervaloConteo);

                        if (bsModal) {
                            bsModal.hide();
                        }

                        timeoutAviso = setTimeout(mostrarAviso, TIEMPO_AVISO_MS);
                        timeoutCierre = setTimeout(forzarCierre, TIEMPO_CIERRE_MS);
                    }

                    function mostrarAviso() {
                        if (!bsModal && typeof bootstrap !== 'undefined' && modalElement) {
                            bsModal = new bootstrap.Modal(modalElement);
                        }
                        if (bsModal) {
                            bsModal.show();
                        }

                        let segundosRestantes = 60;
                        const display = document.getElementById('contadorSegundos');
                        if (display) {
                            display.innerText = segundosRestantes + "s";
                        }

                        intervaloConteo = setInterval(() => {
                            segundosRestantes--;
                            if (display && segundosRestantes >= 0) {
                                display.innerText = segundosRestantes + "s";
                            }
                            if (segundosRestantes <= 0) {
                                clearInterval(intervaloConteo);
                            }
                        }, 1000);
                    }

                    function forzarCierre() {
                        const form = document.createElement("form");
                        form.method = "post";
                        form.action = "@Url.Action("Logout", "Account")";

                        const tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                        if (tokenInput) {
                            const tokenClon = tokenInput.cloneNode();
                            form.appendChild(tokenClon);
                        }

                        document.body.appendChild(form);
                        form.submit();
                    }

                    // Reinicia el temporizador si el modal no se está mostrando
                    const eventosActividad = ["mousemove", "mousedown", "keydown", "touchstart", "scroll"];
                    eventosActividad.forEach(evento => {
                        window.addEventListener(evento, () => {
                            if (!modalElement || !modalElement.classList.contains('show')) {
                                reiniciarTemporizadores();
                            }
                        }, true);
                    });

                    // Acción de botón "Mantener sesión"
                    const btnExtender = document.getElementById('btnExtenderSesion');
                    if (btnExtender) {
                        btnExtender.addEventListener('click', function () {
                            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

                            fetch('@Url.Action("ExtenderSesion", "Account")', {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': token
                                }
                            }).then(() => {
                                reiniciarTemporizadores();
                            }).catch(() => {
                                reiniciarTemporizadores();
                            });
                        });
                    }

                    reiniciarTemporizadores();
                })();
        </script>
    }
</body>
</html>
